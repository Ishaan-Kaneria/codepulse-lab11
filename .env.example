# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore - never push it to GitHub.

# Option 1: local PostgreSQL (pgAdmin / psql on your laptop)
PGHOST=localhost
PGPORT=5432
PGDATABASE=leetcode_lab
PGUSER=postgres
PGPASSWORD=your_password_here

# Option 2: hosted PostgreSQL (Neon / Supabase) - used by Netlify.
# If DATABASE_URL is set it wins over the PG* values above.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

PORT=3000
